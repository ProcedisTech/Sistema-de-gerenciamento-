# Porta do Vite (opcional)
# VITE_PORT=5173

# Proxy /api → Spring Boot (opcional; padrão http://localhost:8080)
# VITE_API_PROXY_TARGET=http://localhost:8080

# Se o Spring devolver accessToken no JSON do login ou GET /auth/me, o front envia Authorization: Bearer
# (sessionStorage procedi_access_token) junto com o cookie jwt e X-Org-Id.
#
# Base URL das requisições: deixe VAZIO em dev com cookie jwt — assim tudo vai para :5173/api/... (proxy).
# NÃO use http://localhost:8080 aqui com auth por cookie: o cookie fica no host errado e o POST não manda jwt.
# No Netlify (front) apontando para o Render (API), use a URL pública do backend, sem barra final, ex.:
# VITE_API_BASE_URL=https://sua-api.onrender.com

# Ping antes de liberar login — GET público que prove que o Spring responde (401 ainda conta como “online”).
# VITE_BACKEND_PING_PATH=/api/auth/me

# Timeout por tentativa (ms). Render “cold start” pode passar de 1 minuto na primeira vez.
# VITE_BACKEND_PING_TIMEOUT_MS=55000

# Intervalo entre tentativas automáticas quando o servidor não responde (ms).
# VITE_BACKEND_RETRY_INTERVAL_MS=10000

# Apenas desenvolvimento local sem backend — NUNCA true em produção.
# VITE_SKIP_BACKEND_CHECK=false

# UUID da organização (opcional, só em dev single-tenant). NÃO use o placeholder
# b0000000-0000-0000-0000-000000000001 — ele é ignorado pelo app (seed histórica).
# Com cadastro completo, o front grava a org real vinda da API no localStorage.
# VITE_DEFAULT_ORG_ID=

# Segunda org só para troca manual na DevContextBar (opcional)
# VITE_ALT_ORG_ID=

# Timeout de inatividade (minutos). Padrão: 15. Aviso 2 min antes.
# VITE_SESSION_TIMEOUT_MIN=15

# Supabase Config
# VITE_SUPABASE_URL=https://iodgzathtyvslqifvotg.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
