exports[`snapshot — Step2Anamnese em consultaMode > anamnese da consulta sem fichas no servidor 1`] = `"<div class="min-w-0"><div class="mb-5 flex items-center gap-3 border-b border-slate-100 pb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-stethoscope h-5 w-5 shrink-0 text-[#00a88e]" aria-hidden="true"><path d="M11 2v2"></path><path d="M5 2v2"></path><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"></path><path d="M8 15a6 6 0 0 0 12 0v-3"></path><circle cx="20" cy="10" r="2"></circle></svg><div class="min-w-0"><h3 class="text-[16px] font-semibold text-slate-800">Dados clínicos do paciente</h3><p class="text-[12px] text-slate-500">Perfil permanente e ficha desta consulta</p></div></div><div class="mb-5 mt-8 min-w-0 border-t-2 border-slate-300 pt-8"><div class="mb-4 flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list mt-0.5 h-5 w-5 shrink-0 text-[#00a88e]" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="M12 11h4"></path><path d="M12 16h4"></path><path d="M8 11h.01"></path><path d="M8 16h.01"></path></svg><div class="min-w-0 pb-1"><p class="text-[11px] font-bold uppercase tracking-wide text-slate-800">Ficha de anamnese desta consulta</p><p class="mt-0.5 text-[12px] text-slate-500">Perguntas específicas desta consulta</p></div></div><div class="relative mb-6 min-w-0"><p class="mb-3 text-[11px] font-bold uppercase tracking-[0.08em] text-[#94a3b8]">Selecionar ficha de anamnese</p><button type="button" class="flex w-full items-center gap-3 rounded-xl border-2 px-4 py-3.5 transition-all duration-150 border-[#e2e8f0] bg-white hover:border-[#00a88e]/40 hover:bg-[#f8fafc]"><div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#f1f5f9]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list h-4 w-4 text-[#94a3b8]" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="M12 11h4"></path><path d="M12 16h4"></path><path d="M8 11h.01"></path><path d="M8 16h.01"></path></svg></div><div class="min-w-0 flex-1 text-left"><p class="text-[14px] text-[#94a3b8]">Selecione uma ficha de anamnese</p></div><div class="flex shrink-0 items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 text-[#94a3b8] transition-transform duration-150" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></div></button></div><form class="space-y-6 bg-white border rounded-2xl p-6 border-[#00a88e]/25"><div><h4 class="mb-1 text-[15px] font-bold text-[#0f172a]">Queixa e Expectativas</h4></div><div class="space-y-2"><label class="ml-1 text-[13px] font-bold text-[#00a88e]">Queixa Principal<span class="text-red-500"> *</span></label><div class="relative"><textarea data-campo-consulta="avaliacao:queixa" rows="4" class="w-full rounded-xl border-[2px] p-3 text-[16px] font-medium outline-none focus:ring-2 focus:ring-[#00a88e]/25 sm:text-[14px] bg-[#f8fbfb] border-[#e2e8f0] focus:border-[#00a88e]" placeholder="Descreva o motivo da consulta...">Rugas na testa</textarea></div></div><div class="space-y-2"><label class="ml-1 text-[13px] font-bold text-[#00a88e]">Expectativas do Paciente<span class="text-red-500">