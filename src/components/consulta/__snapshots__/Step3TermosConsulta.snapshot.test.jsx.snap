exports[`snapshot — Step4LGPD (Step3Termos) no módulo termos da consulta > termos da consulta com um catálogo, nenhum termo no servidor 1`] = `"<div class="min-w-0"><div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><div class="flex items-center gap-4"><div class="rounded-2xl border border-emerald-200 bg-[#dcfce7] p-3 text-[#22c55e]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield h-7 w-7" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg></div><div><h3 class="text-[20px] font-bold text-[#0f172a]">Termos de consentimento</h3><p class="text-[14px] font-medium text-[#64748b]">Leitura e assinaturas (profissional e paciente)</p></div></div></div><div class="relative mb-6"><p class="mb-2 text-[13px] font-medium text-[#64748b]">Selecione os termos que deseja assinar nesta consulta</p><button type="button" class="flex w-full items-center gap-3 rounded-xl border-2 px-4 py-3.5 transition-all duration-150 border-[#e2e8f0] bg-white hover:border-[#00a88e]/40 hover:bg-[#f8fafc]"><div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#f1f5f9]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text h-4 w-4 text-[#94a3b8]" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg></div><div class="min-w-0 flex-1 text-left"><p class="text-[14px] text-[#