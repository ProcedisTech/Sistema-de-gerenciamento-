// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshot — PlanosTab variante consulta > paciente com um plano ativo 1`] = `"<div class="flex flex-col gap-4"><div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-[18px] font-bold text-[#0f172a] sm:text-[20px]">Planejamento</h2><button type="button" class="rounded-xl border border-app-border bg-white px-4 py-2.5 text-[13px] font-semibold text-[#64748b] transition-colors hover:bg-app-nav-hover">Voltar ao hub</button></div><div class="flex flex-wrap items-center justify-between gap-3"><button type="button" class="inline-flex items-center gap-1.5 rounded-lg bg-[#00a88e] px-3 py-2 text-[12px] font-semibold text-white transition-colors hover:bg-[#00967f] disabled:opacity-60"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Novo plano</button></div><div class="space-y-2 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xs"><div class="relative"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search absolute left-3 top-2.5 h-4 w-4 text-slate-400" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input placeholder="Buscar procedimento no catálogo ou digite / para atalho…" class="w-full rounded-xl border border-slate-200 bg-slate-50/50 py-2 pl-9 pr-12 text-xs font-medium text-slate-800 outline-none transition-all placeholder:text-slate-400 focus:border-[#00a88e] focus:bg-white focus:ring-2 focus:ring-[#00a88e]/10" type="text" value=""><div class="absolute right-2.5 top-2 rounded border border-slate-200 bg-white px-1.5 py-0.5 text-[10px] font-mono text-slate-400">/</div></div><div class="flex flex-wrap items-center gap-1.5 pt-0.5"><span class="text-[11px] font-bold text-slate-400 mr-1">Rápidos:</span></div></div><div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start"><div class="lg:col-span-8 space-y-4"><div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs space-y-3"><div class="flex items-center gap-2.5 flex-wrap"><h1 class="text-lg font-extrabold tracking-tight text-slate-900">Plano de tratamento</h1><span class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200">MONTANDO</span><span class="text-xs text-slate-400 font-medium">Aberto há 35 dias · 1 procedimento</span></div><div class="pt-2 border-t border-slate-100 space-y-2"><div class="h-2 w-full rounded-full bg-slate-100 overflow-hidden flex"><div style="width: 0%;" class="bg-teal-600 transition-all duration-300" title="0 realizados"></div><div style="width: 100%;" class="bg-teal-300 transition-all duration-300" title="1 agendados"></div><div style="width: 0%;" class="bg-slate-200 transition-all duration-300" title="0 sem data"></div></div><div class="flex items-center gap-4 flex-wrap text-xs text-slate-500"><span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-teal-600 inline-block"></span><b class="font-bold text-slate-800">0</b> realizados</span><span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-teal-300 inline-block"></span><b class="font-bold text-slate-800">1</b> agendados</span><span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-slate-300 inline-block"></span><b class="font-bold text-slate-800">0</b> sem data</span></div></div></div><div class="rounded-2xl border border-slate-200/80 bg-white p-3.5 shadow-2xs space-y-1.5"><div class="flex items-center justify-between"><span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">Observações Clínicas do Plano</span><span class="text-[11px] font-medium text-emerald-600 flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-3 w-3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span>Salvo</span></span></div><textarea rows="2" placeholder="Ex: Paciente sensível na região dos lábios, aplicar anestésico tópico 20 min antes…" class="w-full rounded-xl border border-slate-200 bg-slate-50/50 p-2 text-xs text-slate-800 placeholder:text-slate-400 outline-none focus:border-[#00a88e] focus:bg-white transition-all resize-none">Duas sessões</textarea></div><div class="space-y-4"><div class="space-y-3"><div class="px-1 text-[11px] font-extrabold uppercase tracking-wider text-slate-500">Cronograma de Visitas</div><div class="relative pl-4 border-l-2 border-[#00a88e] space-y-4"><div class="relative"><span class="absolute -left-[21.5px] top-1.5 w-2.5 h-2.5 rounded-full border-2 border-white shadow-2xs bg-[#00a88e]"></span><div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-2xs space-y-2.5"><div class="flex items-center justify-between pb-2 border-b border-slate-100 flex-wrap gap-2"><div class="flex items-center gap-2"><span class="font-bold text-slate-900 text-[13px]">Visita 1 · Hoje</span><span class="text-[11px] text-slate-400">(30min)</span></div><div class="flex items-center gap-2"><span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-teal-50 text-teal-800 border border-teal-200">1 procedimento</span></div></div><div class="space-y-1.5"><div class="rounded-xl border border-slate-200 bg-white p-3 shadow-2xs hover:border-slate-300 transition-colors "><div class="flex flex-col lg:flex-row lg:items-center justify-between gap-2.5 lg:gap-4"><div class="flex items-start sm:items-center gap-2.5 sm:gap-3 min-w-0 flex-1"><button type="button" aria-label="Selecionar procedimento" class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md border transition-all border-slate-300 bg-white hover:border-[#00a88e]"><span class="h-2 w-2 rounded-full bg-slate-200"></span></button><div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 bg-teal-50 text-[#00a88e]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-syringe w-4 h-4" aria-hidden="true"><path d="m18 2 4 4"></path><path d="m17 7 3-3"></path><path d="M19 9 8.7 19.3c-1 1-2.5 1-3.4 0l-.6-.6c-1-1-1-2.5 0-3.4L15 5"></path><path d="m9 11 4 4"></path><path d="m5 19-3 3"></path><path d="m14 4 6 6"></path></svg></div><div class="min-w-0 flex-1"><div class="flex items-center gap-2"><span class="text-sm font-semibold text-slate-800">Toxina botulínica</span></div><div class="flex flex-wrap items-center gap-1.5 text-[11px] text-slate-400 mt-0.5"><span class="px-1.5 py-0.2 rounded font-medium bg-[#f1f5f9] text-[#64748b] border-[#e2e8f0]">PLANEJADO</span><span>·</span><span>1ª vez</span></div></div></div><div class="flex items-center justify-between lg:justify-end gap-2.5 sm:gap-3 shrink-0 flex-wrap sm:flex-nowrap border-t lg:border-t-0 border-slate-100 pt-2.5 lg:pt-0 mt-0.5 lg:mt-0"><div class="text-left lg:text-right shrink-0"><div class="text-sm font-bold text-slate-800 tabular-nums">R$&nbsp;1.500,00</div><div class="text-[10px] text-slate-400 font-medium">planejado</div></div><div class="flex items-center gap-1.5 flex-wrap sm:flex-nowrap relative"><div class="relative"><button type="button" title="Mudar data planejada" class="inline-flex h-9 sm:h-10 items-center gap-1.5 px-2.5 sm:px-3 rounded-xl border border-slate-200 bg-white text-slate-600 text-xs font-semibold hover:border-teal-300 hover:bg-teal-50 hover:text-teal-700 active:scale-95 shadow-2xs transition-all shrink-0 whitespace-nowrap select-none"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar w-3.5 h-3.5 shrink-0" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg><span>Mudar data</span></button></div><button type="button" title="Iniciar atendimento" class="inline-flex h-9 sm:h-10 items-center gap-1.5 px-2.5 sm:px-3 rounded-xl bg-[#00a88e] text-white text-xs font-bold hover:bg-[#008f79] active:scale-95 shadow-2xs transition-all shrink-0 whitespace-nowrap select-none"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap w-3.5 h-3.5 shrink-0" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg><span>Iniciar</span></button><button type="button" title="Remover do plano" class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl border border-slate-200 bg-white text-slate-400 flex items-center justify-center hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600 active:scale-95 shadow-2xs transition-all shrink-0 select-none"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 w-4 h-4" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></div></div></div></div></div></div></div></div><div class="py-1 text-center text-xs text-slate-400 font-medium">Toque em dois ou mais procedimentos e use <strong class="text-slate-600 font-semibold">Agendar juntos</strong> — vira um agendamento só.</div></div></div><div class="lg:col-span-4 space-y-4"><div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs space-y-3"><div class="flex items-center gap-3"><div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-[#00a88e] font-bold text-sm border border-teal-100">AN</div><div class="min-w-0 flex-1"><h4 class="text-sm font-bold text-slate-800 truncate">Ana Souza</h4><p class="text-[11px] text-slate-400 font-medium">34 anos</p></div></div></div><div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs space-y-3"><div class="flex items-center justify-between"><span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">Próxima Visita</span><span class="rounded-md bg-teal-50 px-2 py-0.5 text-[10px] font-bold text-[#00a88e] border border-teal-100">Agendada</span></div><div class="space-y-2"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar h-4 w-4 text-[#00a88e]" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg><span class="text-xs font-bold text-slate-800">ter., 6 de outubro</span></div><div class="rounded-xl bg-slate-50 p-2.5 space-y-1.5 border border-slate-100"><p class="text-xs font-semibold text-slate-700">Toxina botulínica</p><div class="flex items-center gap-3 text-[11px] text-slate-500"><span class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock h-3 w-3 text-slate-400" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>30 min de cadeira</span><span class="font-mono font-medium text-slate-600">R$&nbsp;1.500,00</span></div></div></div></div><div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs space-y-3"><span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">Discriminação de Valores</span><div class="space-y-2 text-xs"><div class="flex items-center justify-between text-slate-600"><span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>Já realizado</span><span class="font-mono font-medium text-slate-700">R$&nbsp;0,00</span></div><div class="flex items-center justify-between text-slate-600"><span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-teal-500"></span>Agendado</span><span class="font-mono font-medium text-slate-700">R$&nbsp;1.500,00</span></div><div class="flex items-center justify-between text-slate-600"><span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-slate-300"></span>Sem data</span><span class="font-mono font-medium text-slate-700">R$&nbsp;0,00</span></div><div class="pt-2 border-t border-slate-200 flex items-center justify-between font-bold text-slate-900"><span>TOTAL DO PLANO</span><span class="font-mono text-sm text-[#00a88e]">R$&nbsp;1.500,00</span></div></div></div><div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs space-y-3"><span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">Histórico Clínico Recente</span><p class="text-xs text-slate-400 italic">Nenhum procedimento anterior registrado.</p></div></div></div></div>"`;

exports[`snapshot — PlanosTab variante consulta > paciente sem plano 1`] = `"<div class="flex flex-col gap-4"><div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-[18px] font-bold text-[#0f172a] sm:text-[20px]">Planejamento</h2><button type="button" class="rounded-xl border border-app-border bg-white px-4 py-2.5 text-[13px] font-semibold text-[#64748b] transition-colors hover:bg-app-nav-hover">Voltar ao hub</button></div><div class="flex flex-wrap items-center justify-between gap-3"><button type="button" class="inline-flex items-center gap-1.5 rounded-lg bg-[#00a88e] px-3 py-2 text-[12px] font-semibold text-white transition-colors hover:bg-[#00967f] disabled:opacity-60"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Novo plano</button></div><div class="rounded-xl border border-dashed border-[#cbd5e1] bg-[#f8fbfb] px-4 py-10 text-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open mx-auto h-8 w-8 text-[#94a3b8]" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg><p class="mt-2 text-[14px] font-semibold text-[#475569]">Nenhum plano cadastrado</p><p class="mt-1 text-[13px] text-[#94a3b8]">Crie um plano e adicione procedimentos do catálogo.</p></div></div>"`;
