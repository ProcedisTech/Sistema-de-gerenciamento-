exports[`snapshot — ConsultaAvaliacaoFlow > avaliação com queixa, expectativas e duas fotos 1`] = `"<div class="relative flex min-h-0 flex-col"><div class="mb-6 flex shrink-0 items-center gap-4 px-0.5"><div class="rounded-xl border border-app-border bg-app-nav-active p-2.5 text-app-accent shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye h-6 w-6" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></div><div><h3 class="text-[18px] font-bold text-app-ink">Avaliação</h3><p class="text-[13px] font-medium text-[#64748b]">Fotos e desenho sobre as imagens</p></div></div><div class="mb-8 space-y-6 rounded-2xl border border-[#00a88e]/25 bg-white p-6"><div><h4 class="mb-1 text-[15px] font-bold text-[#0f172a]">Queixa e Expectativas</h4><p class="text-[12px] font-medium text-[#64748b]">Mesmos campos da anamnese — editáveis aqui também</p></div><div class="space-y-2"><label class="ml-1 text-[13px] font-bold text-[#00a88e]" for="consulta-avaliacao-queixa">Queixa Principal</label><textarea id="consulta-avaliacao-queixa" data-campo-consulta="avaliacao:queixa" rows="3" class="w-full rounded-xl border-[2px] border-[#e2e8f0] bg-[#f8fbfb] p-3 text-[16px] font-medium outline-none focus:border-[#00a88e] focus:ring-2 focus:ring-[#00a88e]/25 sm:text-[14px]" placeholder="Descreva o motivo da consulta...">Rugas na testa</textarea></div><div class="space-y-2"><label class="ml-1 text-[13px] font-bold text-[#00a88e]" for="consulta-avaliacao-expectativas">Expectativas do Paciente</label><textarea id="consulta-avaliacao-expectativas" data-campo-consulta="avaliacao:expectativas" rows="3" class="w-full rounded-xl border-[2px] border-[#e2e8f0] bg-[#f8fbfb] p-3 text-[16px] font-medium outline-none focus:border-[#00a88e] focus:ring-2 focus:ring-[#00a88e]/25 sm:text-[14px]" placeholder="O que o paciente espera alcançar...">Aparência descansada</textarea></div><div class="space-y-2"><label class="ml-1 text-[13px] font-bold text-[#00a88e]" for="consulta-avaliacao-observacoes">Observações da avaliação</label><textarea id="consulta-avaliacao-observacoes" data-campo-consulta="avaliacao:observacoes" rows="3" class="w-full rounded-xl border-[2px] border-[#e2e8f0] bg-[#f8fbfb] p-3 text-[16px] font-medium outline-none focus:border-[#00a88e] focus:ring-2 focus:ring-[#00a88e]/25 sm:text-[14px]" placeholder="Anotações do profissional sobre a avaliação..."></textarea></div></div><div class="mb-2 flex items-center justify-between gap-2"><h4 class="text-[13px] font-bold text-[#00a88e]">Fotos da avaliação</h4><span class="text-[12px] font-semibold text-[#64748b]">2/30</span></div><input accept="image/*" multiple="" class="hidden" type="file"><div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4"><div class="min-w-0"><div class="group relative aspect-square overflow-hidden rounded-xl bg-[#f1f5f9]"><div class="flex h-full w-full items-center justify-center bg-[#e2e8f0] text-[#94a3b8]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image h-8 w-8" aria-label="Imagem indisponível"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg></div><button type="button" class="absolute inset-0 z-[1] flex items-center justify-center bg-black/35 opacity-100 transition-all sm:bg-black/0 sm:opacity-0 sm:group-hover:bg-black/45 sm:group-hover:opacity-100"><span class="rounded-lg bg-white px-3 py-2 text-[12px] font-bold text-[#0f172a] shadow sm:py-1.5">Anotar</span></button><button type="button" class="absolute right-1 top-1 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-[#dc2626] text-white shadow-md active:bg-[#b91c1c] sm:h-7 sm:w-7 sm:hover:bg-[#b91c1c]" aria-label="Remover imagem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 h-3.5 w-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></div><div class="min-w-0"><div class="group relative aspect-square overflow-hidden rounded-xl bg-[#f1f5f9]"><div class="flex h-full w-full items-center justify-center bg-[#e2e8f0] text-[#94a3b8]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image h-8 w-8" aria-label="Imagem indisponível"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg></div><button type="button" class="absolute inset-0 z-[1] flex items-center justify-center bg-black/35 opacity-100 transition-all sm:bg-black/0 sm:opacity-0 sm:group-hover:bg-black/45 sm:group-hover:opacity-100"><span class="rounded-lg bg-white px-3 py-2 text-[12px] font-bold text-[#0f172a] shadow sm:py-1.5">Anotar</span></button><button type="button" class="absolute right-1 top-1 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-[#dc2626] text-white shadow-md active:bg-[#b91c1c] sm:h-7 sm:w-7 sm:hover:bg-[#b91c1c]" aria-label="Remover imagem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"