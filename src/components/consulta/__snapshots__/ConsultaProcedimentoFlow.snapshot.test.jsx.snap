exports[`snapshot — ConsultaProcedimentoFlow + MapaAplicacaoPanel > fase de orientações e finalização 1`] = `"<div class="min-w-0 pb-4"><div class="mb-6"><div class="mb-3 flex items-center justify-between"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text h-5 w-5 text-[#00a88e]" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg><h4 class="text-[16px] font-bold text-[#0f172a]">Resumo do Atendimento</h4></div><button type="button" class="flex items-center gap-1.5 rounded-lg border border-[#e2e8f0] bg-white px-3 py-2 text-[12px] font-semibold text-[#64748b] transition-colors hover:border-[#00a88e]/40 hover:text-[#00a88e]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download h-3.5 w-3.5" aria-hidden="true"><path d="M12 15V3"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path></svg>Exportar PDF</button></div><div class="space-y-4 rounded-2xl border border-[#e2e8f0] bg-white p-5"><div class="flex items-center justify-between border-b border-[#f1f5f9] pb-3"><div><div class="text-[11px] font-bold uppercase tracking-wide text-[#94a3b8]">Procedi — Sistema de Gestão Clínica</div><div class="mt-0.5 text-[11px] text-[#94a3b8]">Gerado em 06/10/2026, 10:00</div></div></div><div class="flex items-start gap-4 py-1"><div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#f0fdfa]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user h-4 w-4 text-[#00a88e]" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div><div><div class="text-[12px] font-bold uppercase tracking-widest text-[#94a3b8]">Paciente</div><div class="text-[15px] font-semibold text-[#0f172a]">Ana Souza, 34 anos</div><div class="text-[13px] text-[#64748b]">CPF: 12345678909</div></div></div><div class="border-b border-[#f1f5f9]"></div><div class="flex items-start gap-4 py-1"><div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#f0fdfa]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar h-4 w-4 text-[#00a88e]" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg></div><div><div class="text-[12px] font-bold uppercase tracking-widest text-[#94a3b8]">Data e Profissional</div><div class="text-[15px] font-semibold text-[#0f172a]">06/10/2026</div><div class="text-[13px] text-[#64748b]">Profissional: Dra. Beatriz</div></div></div><div class="border-b border-[#f1f5f9]"></div><div class="flex items-start gap-4 py-1"><div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#f0fdfa]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-stethoscope h-4 w-4 text-[#00a88e]" aria-hidden="true"><path d="M11 2v2"></path><path d="M5 2v2"></path><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"></path><path d="M8 15a6 6 0 0 0 12 0v-3"></path><circle cx="20" cy="10" r="2"></circle></svg></div><div><div class="text-[12px] font-bold uppercase tracking-widest text-[#94a3b8]">Procedimento</div><div class="text-[15px] font-semibold text-[#0f172a]"><div>Toxina botulínica</div></div><div class="mt-1 text-[13px] leading-relaxed text-[#475569] whitespace-pre-wrap">Aplicação sem intercorrências</div></div></div><div class="border-b border-[#f1f5f9]"></div><div class="flex items-start gap-4 py-1"><div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#f0fdfa]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open h-4 w-4 text-[#00a88e]" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></div><div><div class="text-[12px] font-bold uppercase tracking-widest text-[#94a3b8]">Queixa</div><div class="text-[13px] leading-relaxed text-[#475569]">Rugas na testa</div></div></div><div class="border-b border-[#f1f5f9]"></div><div class="flex items-start gap-4 py-1"><div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#f0fdfa]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera h-4 w-4 text-[#00a88e]" aria-hidden="true"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg></div><div class="min-w-0 flex-1"><div class="text-[12px] font-bold uppercase tracking-widest text-[#94a3b8]">Registro Fotográfico</div><div class="mt-0.5 text-[13px] text-[#64748b]">3 foto(s) registrada(s)</div><div class="mt-3"><div class="mb-2 text-[11px] font-bold uppercase tracking-wide text-[#00a88e]">Avaliação (2)</div><div class="grid grid-cols-3 gap-2"><div class="group relative aspect-square overflow-hidden rounded-lg border border-[#e2e8f0] bg-[#f1f5f9]"><img alt="" crossorigin="anonymous" style="width: 100%; height: 100%; object-fit: cover; display: block;" src="https://fotos.teste/avaliacao-1.jpg"><div class="absolute bottom-1 left-1 rounded bg-black/50 px-1.5 py-0.5 text-[10px] font-bold text-white">1</div></div><div class="group relative aspect-square overflow-hidden rounded-lg border border-[#e2e8f0] bg-[#f1f5f9]"><img alt="" crossorigin="anonymous" style="width: 100%; height: 100%; object-fit: cover; display: block;" src="https://fotos.teste/avaliacao-2.jpg"><div class="absolute bottom-1 left-1 rounded bg-black/50 px-1.5 py-0.5 text-[10px] font-bold text-white">2</div></div></div></div><div class="mt-3"><div class="mb-2 text-[11px] font-bold uppercase tracking-wide text-[#64748b]">Procedimento (1)</div><div class="grid grid-cols-3 gap-2"><div class="group relative aspect-square overflow-hidden rounded-lg border border-[#e2e8f0] bg-[#f1f5f9]"><img alt="" crossorigin="anonymous" style="width: 100%; height: 100%; object-fit: cover; display: block;" src="https://fotos.teste/procedimento-1.jpg"><div class="absolute bottom-1 left-1 rounded bg-black/50 px-1.5 py-0.5 text-[10px] font-bold text-white">1</div></div></div></div></div></div><div class="border-b border-[#f1f5f9]"></div><div class="pt-1 text-center"><div class="text-[10px] text-[#94a3b8]">Documento gerado pelo sistema Procedi — válido como registro clínico interno</div></div></div></div><div class="mb-8 flex items-center gap-4"><div class="rounded-2xl border border-emerald-200 bg-[#dcfce7] p-3 text-[#22c55e]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big h-7 w-7" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg></div><div><h3 class="text-[20px] font-bold text-[#0f172a]">Finalização do Procedimento</h3><p class="text-[14px] font-medium text-[#64748b]">Orientações e confirmações finais</p></div></div><div class="space-y-6 rounded-2xl border bg-white p-6 border-[#00a88e]/25"><div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><h4 class="text-[18px] font-bold text-[#0f766e]">Orientações Pós-Procedimento</h4><div class="flex flex-wrap gap-2"><button type="button" data-campo-consulta="item:item-1:orient" class="inline-flex items-center gap-1.5 rounded-lg border border-[#00a88e]/40 bg-[#f0fdf9] px-3 py-2 text-[12px] font-bold text-[#0f766e] transition-colors hover:bg-[#e6f7f5]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Adicionar orientação</button><button type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-[#25D366]/50 bg-[#dcfce7] px-3 py-2 text-[12px] font-bold text-[#166534] transition-colors hover:bg-[#bbf7d0]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle h-4 w-4" aria-hidden="true"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"></path></svg>Enviar por WhatsApp</button></div></div><section data-item-orientacoes="0" class=""><div class="space-y-2"><div class="flex items-start gap-3 rounded-lg border p-3 border-[#86efac] bg-[#f0fdf4]"><button type="button" role="checkbox" aria-checked="true" data-campo-consulta="item:item-1:orient" class="mt-0.5 shrink-0 rounded p-0.5 text-[#00a88e] outline-none focus-visible:ring-2 focus-visible:ring-[#00a88e]/40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-check-big h-5 w-5" aria-hidden="true"><path d="M21 10.656V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12.344"></path><path d="m9 11 3 3L22 4"></path></svg></button><div class="min-w-0 flex-1"><button type="button" data-campo-consulta="item:item-1:orient" class="w-full rounded-lg px-1 py-0.5 text-left text-[14px] font-medium leading-snug text-[#0f172a] hover:bg-black/[0.03]">Não deitar por 4 horas</button></div><button type="button" data-campo-consulta="item:item-1:orient" class="shrink-0 rounded-lg p-2 text-[#94a3b8] transition-colors hover:bg-red-50 hover:text-red-600" aria-label="Remover orientação"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 h-4 w-4" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div><div class="flex items-start gap-3 rounded-lg border p-3 border-[#e2e8f0] bg-[#f8fafc]"><button type="button" role="checkbox" aria-checked="false" data-campo-consulta="item:item-1:orient" class="mt-0.5 shrink-0 rounded p-0.5 text-[#00a88e] outline-none focus-visible:ring-2 focus-visible:ring-[#00a88e]/40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square h-5 w-5 text-[#94a3b8]" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg></button><div class="min-w-0 flex-1"><button type="button" data-campo-consulta="item:item-1:orient" class="w-full rounded-lg px-1 py-0.5 text-left text-[14px] font-medium leading-snug text-[#0f172a] hover:bg-black/[0.03]">Evitar exercício por 24 horas</button></div><button type="button" data-campo-consulta="item:item-1:orient" class="shrink-0 rounded-lg p-2 text-[#94a3b8] transition-colors hover:bg-red-50 hover:text-red-600" aria-label="Remover orientação"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 h-4 w-4" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></div></section></div></div><div class="mt-8 flex justify-end border-t border-app-border pt-8"><button type="button" class="flex h-11 items-center justify-center gap-2 rounded-xl border border-transparent px-6 text-[14px] font-semibold shadow-sm outline-none transition-all animate-pulse bg-[#22c55e] text-white hover:bg-[#16a34a]">Finalizar Atendimento ✓</button></div>"`;

exports[`snapshot — ConsultaProcedimentoFlow + MapaAplicacaoPanel > registro bloqueado por termos 1`] = `"<div class="min-w-0"><div class="mb-6 flex items-center gap-4"><div class="rounded-2xl border border-app-border bg-[#e6f7f5] p-3 text-[#00a88e]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-stethoscope h-7 w-7" aria-hidden="true"><path d="M11 2v2"></path><path d="M5 2v2"></path><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"></path><path d="M8 15a6 6 0 0 0 12 0v-3"></path><circle cx="20" cy="10" r="2"></circle></svg></div><div><h3 class="text-[20px] font-bold text-[#0f172a]">Procedimento</h3><p class="text-[14px] font-medium text-[#64748b]">Registro do que foi realizado e imagens</p></div></div><div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3"><p class="text-[13px] font-semibold text-amber-900">Procedimento bloqueado até a assinatura de: Termo de toxina</p></div><div class="mb-6 space-y-4 rounded-2xl border bg-white p-4 sm:p-6 border-[#00a88e]/25"><div class="space-y-3"><div class="space-y-1.5"><label class="text-[13px] font-bold text-[#00a88e]">Nome do procedimento <span class="text-red-500">*</span></label><div><div class="relative "><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search pointer-events-none absolute left-3 top-1/2 z-[1] h-4 w-4 -translate-y-1/2 text-gray-400" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input role="combobox" aria-expanded="false" aria-autocomplete="list" aria-label="Buscar procedimento" placeholder="Buscar procedimento..." class="w-full rounded-lg border border-gray-200 bg-white py-2.5 pl-10 pr-3 text-[13px] font-medium text-gray-900 outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500/20" autocomplete="off" type="search" value=""></div><div class="mt-2.5"><div class="flex flex-wrap items-center gap-1.5" role="list" aria-label="Procedimentos selecionados"><span role="listitem" class="inline-flex items-center gap-2 rounded-xl border-[1.5px] border-[#00a88e] bg-white px-3 py-1.5 text-xs font-bold text-[#0f172a] shadow-xs transition-all hover:border-[#008f79] hover:shadow-sm"><span class="truncate max-w-[240px] text-slate-900">Toxina botulínica</span><span class="rounded-md bg-[#e6f7f5] px-1.5 py-0.5 text-[10px] font-extrabold text-[#008f79] border border-[#00a88e]/30">Plano</span><button type="button" class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded text-slate-400 hover:bg-rose-50 hover:text-rose-600 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#00a88e] cursor-pointer" aria-label="Remover Toxina botulínica"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x h-3 w-3 stroke-[2.5]" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></span></div></div></div></div></div><div class="space-y-1.5"><label class="text-[13px] font-bold text-[#00a88e]">Descrição detalhada do que foi realizado</label><div class="relative"><textarea placeholder="Ex: Aplicação de 20U de toxina botulínica na glabela, 10U nas linhas frontais. Produto: Dysport lote #XXXX. Paciente tolerou bem..." rows="2" class="w-full resize-none rounded-xl border-[2px] border-[#e2e8f0] px-3.5 py-2 text-[14px] outline-none focus:border-[#00a88e] sm:text-[13px]">Aplicação sem intercorrências</textarea></div></div></div><div class="mb-6 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs sm:p-5"><div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield h-4 w-4 text-[#00a88e]" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg><h4 class="text-[13px] font-bold text-slate-800">Termos de Consentimento da Sessão</h4></div><div class="flex items-center gap-2"><span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle h-3 w-3 animate-spin text-[#00a88e]" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>Verificando termos...</span></div></div><div class="divide-y divide-slate-100 pt-1"><div class="py-3 text-[12px] text-slate-500 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle h-4 w-4 animate-spin text-[#00a88e]" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg><span>Consultando conformidade dos termos de consentimento para os procedimentos selecionados...</span></div><div class="flex flex-wrap items-center justify-between gap-2 py-2.5"><div class="flex items-center gap-2.5 min-w-0"><div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-50 text-rose-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x h-3.5 w-3.5 stroke-[2.5]" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></div><div class="min-w-0 text-[13px]"><span class="font-semibold text-slate-900">Procedimento:</span> <span class="text-slate-600">Termo de toxina</span></div></div></div></div></div><div class="mb-4"><div class="mb-2 flex items-center justify-between"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye h-4 w-4 text-[#64748b]" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg><span class="text-[12px] font-semibold uppercase tracking-wide text-[#64748b]">Avaliação — apenas referência</span></div><span class="text-[11px] text-slate-400 font-medium">Clique para ampliar e ver planejamento</span></div><div class="grid grid-cols-3 gap-2"><button type="button" title="Ampliar avaliação (com zoom e marcações)" class="group relative aspect-square w-full cursor-zoom-in overflow-hidden rounded-xl border border-slate-200 bg-slate-50 p-0 text-left outline-none transition-all hover:border-[#00a88e] hover:shadow-xs focus-visible:ring-2 focus-visible:ring-[#00a88e]"><div class="flex items-center justify-center bg-[#e2e8f0] text-[#94a3b8] h-full w-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image w-8 h-8" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg></d