stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 h-3.5 w-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div><input placeholder="Ex: Detalhe..." class="w-full rounded-lg border border-[#e2e8f0] bg-[#f8fafc] px-2 py-1 text-[11px] text-[#0f172a] outline-none placeholder:text-[#cbd5e1] focus:border-[#00a88e]" type="text" value=""></div></div></div><div class="mt-6"><div class="mb-6 rounded-2xl border border-dashed border-[#cbd5e1] bg-[#f8fafc] p-6 text-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin mx-auto h-8 w-8 text-[#94a3b8]" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg><h4 class="mt-3 text-[15px] font-bold text-app-ink">Mapa de aplicação</h4><p class="mt-1 text-[13px] font-medium text-[#64748b]">Assine os termos obrigatórios para habilitar o mapa de aplicação.</p></div></div></div><div class="mt-8 flex justify-end border-t border-app-border pt-8"><button type="button" disabled="" class="flex h-11 items-center justify-center gap-2 rounded-xl border border-transparent bg-[#00a88e] px-6 text-[14px] font-semibold text-white shadow-sm outline-none transition-all hover:bg-[#00967f] disabled:cursor-not-allowed disabled:opacity-60">Ir para Finalização e Orientações</button></div>"`;

exports[`snapshot — ConsultaProcedimentoFlow + MapaAplicacaoPanel > registro do procedimento com mapa 1`] = `"<div class="min-w-0"><div class="mb-6 flex items-center gap-4"><div class="rounded-2xl border border-app-border bg-[#e6f7f5] p-3 text-[#00a88e]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-stethoscope h-7 w-7" aria-hidden="true"><path d="M11 2v2"></path><path d="M5 2v2"></path><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"></path><path d="M8 15a6 6 0 0 0 12 0v-3"></path><circle cx="20" cy="10" r="2"></circle></svg></div><div><h3 class="text-[20px] font-bold text-[#0f172a]">Procedimento</h3><p class="text-[14px] font-medium text-[#64748b]">Registro do que foi realizado e imagens</p></div></div><div class="mb-6 space-y-4 rounded-2xl border bg-white p-4 sm:p-6 border-[#00a88e]/25"><div class="space-y-3"><div class="space-y-1.5"><label class="text-[13px] font-bold text-[#00a88e]">Nome do procedimento <span class="text-red-500">*</span></label><div><div class="relative "><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search pointer-events-none absolute left-3 top-1/2 z-[1] h-4 w-4 -translate-y-1/2 text-gray-400" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input role="combobox" aria-expanded="false" aria-autocomplete="list" aria-label="Buscar procedimento" placeholder="Buscar procedimento..." class="w-full rounded-lg border border-gray-200 bg-white py-2.5 pl-10 pr-3 text-[13px] font-medium text-gray-900 outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500/20" autocomplete="off" type="search" value=""></div><div class="mt-2.5"><div class="flex flex-wrap items-center gap-1.5" role="list" aria-label="Procedimentos selecionados"><span role="listitem" class="inline-flex items-center gap-2 rounded-xl border-[1.5px] border-[#00a88e] bg-white px-3 py-1.5 text-xs font-bold text-[#0f172a] shadow-xs transition-all hover:border-[#008f79] hover:shadow-sm"><span class="truncate max-w-[240px] text-slate-900">Toxina botulínica</span><span class="rounded-md bg-[#e6f7f5] px-1.5 py-0.5 text-[10px] font-extrabold text-[#008f79] border border-[#00a88e]/30">Plano</span><button type="button" class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded text-slate-400 hover:bg-rose-50 hover:text-rose-600 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#00a88e] cursor-pointer" aria-label="Remover Toxina botulínica"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x h-3 w-3 stroke-[2.5]" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></span></div></div></div></div></div><div class="space-y-1.5"><label class="text-[13px] font-bold text-[#00a88e]">Descrição detalhada do que foi realizado</label><div class="relative"><textarea placeholder="Ex: Aplicação de 20U de toxina botulínica na glabela, 10U nas linhas frontais. Produto: Dysport lote #XXXX. Paciente tolerou bem..." rows="2" class="w-full resize-none rounded-xl border-[2px] border-[#e2e8f0] px-3.5 py-2 text-[14px] outline-none focus:border-[#00a88e] sm:text-[13px]">Aplicação sem intercorrências</textarea></div></div></div><div class="mb-6 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs sm:p-5"><div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width