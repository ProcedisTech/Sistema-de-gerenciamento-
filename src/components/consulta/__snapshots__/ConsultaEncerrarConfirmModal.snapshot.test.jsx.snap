// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshot — ConsultaEncerrarConfirmModal > modal aberto, com procedimento sem termo 1`] = `"<div><div class="fixed inset-0 z-[320] flex items-center justify-center bg-slate-900/45 px-4" role="dialog" aria-modal="true" aria-labelledby="encerrar-consulta-title"><div class="w-full max-w-md rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-2xl"><h4 id="encerrar-consulta-title" class="text-[16px] font-bold text-[#0f172a]">Encerrar ou Sair da consulta?</h4><p class="mt-2 text-[14px] text-[#475569]">O que deseja fazer com o atendimento de Ana Souza?</p><p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-[13px] leading-relaxed text-amber-900">Há um procedimento selecionado que ainda não tem termo assinado. Se encerrar agora, ele não será registrado como realizado no prontuário.</p><div class="mt-6 flex flex-col gap-3"><button type="button" class="h-11 w-full rounded-lg bg-[#00a88e] px-4 text-[14px] font-semibold text-white hover:bg-[#00967f] disabled:opacity-50 flex items-center justify-center">Finalizar Atendimento</button><button type="button" class="h-11 w-full rounded-lg bg-[#f1f5f9] px-4 text-[14px] font-semibold text-[#475569] hover:bg-[#e2e8f0] disabled:opacity-50 flex items-center justify-center">Apenas Sair (Manter em andamento)</button><button type="button" class="h-11 w-full rounded-lg border border-[#e2e8f0] bg-white px-4 text-[14px] font-semibold text-[#64748b] hover:bg-[#f8fafc] disabled:opacity-50">Cancelar</button></div></div></div></div>"`;

exports[`snapshot — ConsultaEncerrarConfirmModal > modal aberto, sem bloqueio de termo 1`] = `"<div><div class="fixed inset-0 z-[320] flex items-center justify-center bg-slate-900/45 px-4" role="dialog" aria-modal="true" aria-labelledby="encerrar-consulta-title"><div class="w-full max-w-md rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-2xl"><h4 id="encerrar-consulta-title" class="text-[16px] font-bold text-[#0f172a]">Encerrar ou Sair da consulta?</h4><p class="mt-2 text-[14px] text-[#475569]">O que deseja fazer com o atendimento de Ana Souza?</p><div class="mt-6 flex flex-col gap-3"><button type="button" class="h-11 w-full rounded-lg bg-[#00a88e] px-4 text-[14px] font-semibold text-white hover:bg-[#00967f] disabled:opacity-50 flex items-center justify-center">Finalizar Atendimento</button><button type="button" class="h-11 w-full rounded-lg bg-[#f1f5f9] px-4 text-[14px] font-semibold text-[#475569] hover:bg-[#e2e8f0] disabled:opacity-50 flex items-center justify-center">Apenas Sair (Manter em andamento)</button><button type="button" class="h-11 w-full rounded-lg border border-[#e2e8f0] bg-white px-4 text-[14px] font-semibold text-[#64748b] hover:bg-[#f8fafc] disabled:opacity-50">Cancelar</button></div></div></div></div>"`;
