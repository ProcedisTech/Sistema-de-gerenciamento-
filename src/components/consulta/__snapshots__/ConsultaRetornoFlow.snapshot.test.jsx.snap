// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshot — ConsultaRetornoFlow > retorno com retoque 1`] = `"<div class="relative flex min-h-0 flex-col"><div class="mb-6 flex shrink-0 items-center gap-4 px-0.5"><div class="rounded-xl border border-app-border bg-app-nav-active p-2.5 text-app-accent shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw h-6 w-6" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg></div><div><h3 class="text-[18px] font-bold text-app-ink">Retorno</h3><p class="text-[13px] font-medium text-[#64748b]">Procedimento original + fotos e mapa desta visita</p></div></div><div class="grid min-h-0 flex-1 gap-6 lg:grid-cols-2"><div class="flex min-h-0 flex-col gap-6"><div class="flex min-h-0 flex-col rounded-2xl border border-[#e2e8f0] bg-white p-5"><div class="mb-4 flex items-start justify-between gap-2"><div><h4 class="text-[15px] font-bold text-[#0f172a]">Procedimento original</h4><p class="text-[12px] text-[#64748b]">Referência da sessão anterior</p></div><span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-[#cbd5e1] bg-[#f8fafc] px-2.5 py-1 text-[11px] font-semibold text-[#64748b]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock h-3 w-3" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>Somente leitura</span></div><dl class="mb-4 space-y-2 text-[13px]"><div><dt class="font-semibold text-[#64748b]">Procedimento</dt><dd class="font-bold text-[#0f172a]">Toxina botulínica</dd></div><div class="grid grid-cols-2 gap-3"><div><dt class="font-semibold text-[#64748b]">Data</dt><dd class="text-[#0f172a]">—</dd></div><div><dt class="font-semibold text-[#64748b]">Profissional</dt><dd class="text-[#0f172a]">—</dd></div></div></dl><div class="mb-4 space-y-4"><p class="text-[12px] font-bold uppercase tracking-wide text-[#00a88e]">Fotos de referência</p><div><p class="mb-1.5 text-[12px] font-semibold text-[#64748b]">Antes</p><p class="text-[11px] text-[#94a3b8]">Sem fotos</p></div><div><p class="mb-1.5 text-[12px] font-semibold text-[#64748b]">Pós-imediato</p><p class="text-[11px] text-[#94a3b8]">Sem fotos</p></div><div><p class="mb-1.5 text-[12px] font-semibold text-[#64748b]">Depois</p><p class="text-[11px] text-[#94a3b8]">Sem fotos</p></div></div><p class="rounded-xl border border-dashed border-[#cbd5e1] bg-[#f8fafc] px-4 py-6 text-center text-[13px] text-[#64748b]">Procedimento original sem mapa registrado.</p></div><div class="rounded-2xl border border-[#cbd5e1] bg-white p-5"><div class="mb-4 flex items-center justify-between gap-2"><div><h4 class="text-[15px] font-bold text-[#0f172a]">Foto do resultado</h4><p class="text-[12px] text-[#64748b]">Fotos do resultado final desta consulta de retorno</p></div><span class="text-[12px] font-semibold text-[#64748b]">2/30</span></div><input accept="image/*" multiple="" class="hidden" type="file"><div class="grid grid-cols-2 gap-3 sm:grid-cols-3"><div class="min-w-0"><div class="group relative aspect-square overflow-hidden rounded-xl bg-[#f1f5f9]"><img alt="" class="h-full w-full object-cover" src="https://fotos.teste/avaliacao-1.jpg"><button type="button" class="absolute right-1 top-1 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-[#dc2626] text-white shadow-md active:bg-[#b91c1c] sm:h-7 sm:w-7 sm:hover:bg-[#b91c1c]" aria-label="Remover imagem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 h-3.5 w-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></div><div class="min-w-0"><div class="group relative aspect-square overflow-hidden rounded-xl bg-[#f1f5f9]"><img alt="" class="h-full w-full object-cover" src="https://fotos.teste/avaliacao-2.jpg"><button type="button" class="absolute right-1 top-1 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-[#dc2626] text-white shadow-md active:bg-[#b91c1c] sm:h-7 sm:w-7 sm:hover:bg-[#b91c1c]" aria-label="Remover imagem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 h-3.5 w-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></div><button type="button" class="col-span-2 flex min-h-[120px] flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-[#cbd5e1] bg-[#fafafa] px-4 py-2 text-[#64748b] transition-colors active:border-[#00a88e]/50 active:bg-[#f0fdf9] active:text-[#00a88e] sm:col-span-1 sm:aspect-square sm:min-h-0 sm:hover:border-[#00a88e]/50 sm:hover:bg-[#f0fdf9] sm:hover:text-[#00a88e]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera h-6 w-6" aria-hidden="true"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg><span class="px-1 text-center text-[11px] font-semibold leading-tight">Upload de imagens</span></button></div></div></div><div class="flex min-h-0 flex-col"><div class="mb-6 flex items-center justify-between gap-4 rounded-2xl border border-[#00a88e]/25 bg-white p-6 shadow-sm"><div><p class="text-[15px] font-bold text-[#0f172a]">Houve retoque nesta visita?</p><p class="text-[12px] text-[#64748b]">Marque Sim para registrar fotos de retoque e mapa corretivo desta visita</p></div><button type="button" role="switch" aria-checked="true" class="relative h-8 w-14 shrink-0 rounded-full transition-colors bg-[#00a88e]"><span class="absolute top-1 h-6 w-6 rounded-full bg-white shadow transition-transform left-7"></span></button></div><div class="mb-6 space-y-6"><div class="rounded-2xl border border-[#00a88e]/25 bg-white p-5 shadow-sm"><h4 class="mb-1 text-[15px] font-bold text-[#0f172a]">Fotos do retoque</h4><p class="mb-4 text-[12px] text-[#64748b]">Registre fotos do paciente antes de aplicar o retoque e pós-imediato desta visita.</p><div class="grid gap-4 sm:grid-cols-2"><div class="rounded-xl border border-[#cbd5e1] bg-[#f8fafc] p-4"><div class="mb-3 flex items-center justify-between gap-2"><div><h5 class="text-[13px] font-bold text-[#0f172a]">Pré-retoque (Antes)</h5><p class="text-[11px] text-[#64748b]">Antes de aplicar o retoque</p></div><span class="text-[11px] font-semibold text-[#64748b]">0 foto(s)</span></div><input accept="image/*" multiple="" class="hidden" type="file"><div class="flex flex-wrap gap-2.5"><button type="button" class="flex h-20 w-20 flex-col items-center justify-center gap-1 rounded-xl border border-app-accent/40 bg-app-nav-active text-[#00a88e] hover:bg-[#e6f7f5] transition-colors" title="Tirar foto com a câmera"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera h-5 w-5" aria-hidden="true"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg><span class="text-[10px] font-semibold">Câmera</span></button><button type="button" class="flex h-20 w-20 flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-[#cbd5e1] bg-white text-[#64748b] hover:border-[#00a88e]/50 hover:bg-[#f0fdf9] hover:text-[#00a88e] transition-colors" title="Upload de arquivo de imagem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image h-5 w-5" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg><span class="text-[10px] font-semibold">Arquivo</span></button></div></div><div class="rounded-xl border border-[#cbd5e1] bg-[#f8fafc] p-4"><div class="mb-3 flex items-center justify-between gap-2"><div><h5 class="text-[13px] font-bold text-[#0f172a]">Pós-imediato (Retoque)</h5><p class="text-[11px] text-[#64748b]">Logo após aplicar o retoque</p></div><span class="text-[11px] font-semibold text-[#64748b]">0 foto(s)</span></div><input accept="image/*" multiple="" class="hidden" type="file"><div class="flex flex-wrap gap-2.5"><button type="button" class="flex h-20 w-20 flex-col items-center justify-center gap-1 rounded-xl border border-app-accent/40 bg-app-nav-active text-[#00a88e] hover:bg-[#e6f7f5] transition-colors" title="Tirar foto com a câmera"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera h-5 w-5" aria-hidden="true"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg><span class="text-[10px] font-semibold">Câmera</span></button><button type="button" class="flex h-20 w-20 flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-[#cbd5e1] bg-white text-[#64748b] hover:border-[#00a88e]/50 hover:bg-[#f0fdf9] hover:text-[#00a88e] transition-colors" title="Upload de arquivo de imagem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image h-5 w-5" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg><span class="text-[10px] font-semibold">Arquivo</span></button></div></div></div></div><div class="rounded-2xl border border-[#00a88e]/25 bg-white p-5 shadow-sm"><h4 class="mb-1 text-[15px] font-bold text-[#0f172a]">Mapa de retoque</h4><p class="mb-4 text-[12px] text-[#64748b]">Tire ou envie uma foto nova desta visita e marque pontos e traços sobre ela.</p><div class="flex items-center gap-2 overflow-x-auto pb-1 [-webkit-overflow-scrolling:touch]"><button type="button" class="relative shrink-0 rounded-xl border px-3 py-2 text-left transition-colors border-app-accent bg-app-nav-active shadow-sm"><span class="block text-[12px] font-bold text-[#0f766e]">Frontal</span><span class="text-[10px] font-medium text-[#94a3b8]">Rosto</span></button></div><div class="mt-3"><div class="flex items-center justify-between gap-2"><div class="mb-3 flex flex-wrap items-center gap-2"><h4 class="text-[14px] font-bold text-app-ink">Frontal</h4><span class="rounded-md bg-[#e6f7f5] px-2 py-0.5 text-[11px] font-semibold text-[#00a88e]">Rosto</span></div></div><div class="flex min-h-[320px] flex-1 flex-col rounded-xl border border-app-border bg-white p-4 shadow-app-card"><div class="flex min-h-[280px] flex-1 flex-col border-0 p-0 shadow-none"><div class="flex flex-1 flex-col items-center justify-center gap-5 rounded-xl border border-dashed border-app-accent/30 bg-app-canvas p-8 text-center min-h-[320px]"><div class="rounded-xl bg-app-nav-active p-4 text-app-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image h-10 w-10" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg></div><div><p class="text-[15px] font-bold text-app-ink">Adicione uma foto para esta vista</p><p class="mt-1 text-[13px] font-medium text-[#64748b]">Escolha da galeria, capture ou faça upload do dispositivo.</p></div><div class="flex flex-wrap justify-center gap-3"><button type="button" class="inline-flex items-center gap-2 rounded-xl bg-app-accent px-4 py-2.5 text-[13px] font-semibold text-white shadow-sm hover:bg-[#00967f] disabled:cursor-not-allowed disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera h-4 w-4" aria-hidden="true"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg>Capturar</button><button type="button" class="inline-flex items-center gap-2 rounded-xl border border-app-border bg-white px-4 py-2.5 text-[13px] font-semibold text-[#475569] shadow-sm hover:bg-[#f8fafc] disabled:cursor-not-allowed disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload h-4 w-4" aria-hidden="true"><path d="M12 3v12"></path><path d="m17 8-5-5-5 5"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path></svg>Upload</button><input accept="image/*" class="hidden" type="file"></div></div></div></div></div></div></div><div class="mt-auto flex justify-end border-t border-app-border pt-6"><button type="button" class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-xl bg-app-accent px-6 py-3 text-[14px] font-semibold text-white shadow-sm hover:bg-[#00967f] disabled:cursor-not-allowed disabled:opacity-60">Concluir Retorno</button></div></div></div></div>"`;

exports[`snapshot — ConsultaRetornoFlow > retorno sem retoque, origem sem dados no servidor 1`] = `"<div class="relative flex min-h-0 flex-col"><div class="mb-6 flex shrink-0 items-center gap-4 px-0.5"><div class="rounded-xl border border-app-border bg-app-nav-active p-2.5 text-app-accent shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw h-6 w-6" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg></div><div><h3 class="text-[18px] font-bold text-app-ink">Retorno</h3><p class="text-[13px] font-medium text-[#64748b]">Procedimento original + fotos e mapa desta visita</p></div></div><div class="grid min-h-0 flex-1 gap-6 lg:grid-cols-2"><div class="flex min-h-0 flex-col gap-6"><div class="flex min-h-0 flex-col rounded-2xl border border-[#e2e8f0] bg-white p-5"><div class="mb-4 flex items-start justify-between gap-2"><div><h4 class="text-[15px] font-bold text-[#0f172a]">Procedimento original</h4><p class="text-[12px] text-[#64748b]">Referência da sessão anterior</p></div><span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-[#cbd5e1] bg-[#f8fafc] px-2.5 py-1 text-[11px] font-semibold text-[#64748b]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock h-3 w-3" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>Somente leitura</span></div><dl class="mb-4 space-y-2 text-[13px]"><div><dt class="font-semibold text-[#64748b]">Procedimento</dt><dd class="font-bold text-[#0f172a]">Toxina botulínica</dd></div><div class="grid grid-cols-2 gap-3"><div><dt class="font-semibold text-[#64748b]">Data</dt><dd class="text-[#0f172a]">—</dd></div><div><dt class="font-semibold text-[#64748b]">Profissional</dt><dd class="text-[#0f172a]">—</dd></div></div></dl><div class="mb-4 space-y-4"><p class="text-[12px] font-bold uppercase tracking-wide text-[#00a88e]">Fotos de referência</p><div><p class="mb-1.5 text-[12px] font-semibold text-[#64748b]">Antes</p><p class="text-[11px] text-[#94a3b8]">Sem fotos</p></div><div><p class="mb-1.5 text-[12px] font-semibold text-[#64748b]">Pós-imediato</p><p class="text-[11px] text-[#94a3b8]">Sem fotos</p></div><div><p class="mb-1.5 text-[12px] font-semibold text-[#64748b]">Depois</p><p class="text-[11px] text-[#94a3b8]">Sem fotos</p></div></div><p class="rounded-xl border border-dashed border-[#cbd5e1] bg-[#f8fafc] px-4 py-6 text-center text-[13px] text-[#64748b]">Procedimento original sem mapa registrado.</p></div><div class="rounded-2xl border border-[#cbd5e1] bg-white p-5"><div class="mb-4 flex items-center justify-between gap-2"><div><h4 class="text-[15px] font-bold text-[#0f172a]">Foto do resultado</h4><p class="text-[12px] text-[#64748b]">Fotos do resultado final desta consulta de retorno</p></div><span class="text-[12px] font-semibold text-[#64748b]">2/30</span></div><input accept="image/*" multiple="" class="hidden" type="file"><div class="grid grid-cols-2 gap-3 sm:grid-cols-3"><div class="min-w-0"><div class="group relative aspect-square overflow-hidden rounded-xl bg-[#f1f5f9]"><img alt="" class="h-full w-full object-cover" src="https://fotos.teste/avaliacao-1.jpg"><button type="button" class="absolute right-1 top-1 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-[#dc2626] text-white shadow-md active:bg-[#b91c1c] sm:h-7 sm:w-7 sm:hover:bg-[#b91c1c]" aria-label="Remover imagem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 h-3.5 w-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></div><div class="min-w-0"><div class="group relative aspect-square overflow-hidden rounded-xl bg-[#f1f5f9]"><img alt="" class="h-full w-full object-cover" src="https://fotos.teste/avaliacao-2.jpg"><button type="button" class="absolute right-1 top-1 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-[#dc2626] text-white shadow-md active:bg-[#b91c1c] sm:h-7 sm:w-7 sm:hover:bg-[#b91c1c]" aria-label="Remover imagem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 h-3.5 w-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></div><button type="button" class="col-span-2 flex min-h-[120px] flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-[#cbd5e1] bg-[#fafafa] px-4 py-2 text-[#64748b] transition-colors active:border-[#00a88e]/50 active:bg-[#f0fdf9] active:text-[#00a88e] sm:col-span-1 sm:aspect-square sm:min-h-0 sm:hover:border-[#00a88e]/50 sm:hover:bg-[#f0fdf9] sm:hover:text-[#00a88e]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera h-6 w-6" aria-hidden="true"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg><span class="px-1 text-center text-[11px] font-semibold leading-tight">Upload de imagens</span></button></div></div></div><div class="flex min-h-0 flex-col"><div class="mb-6 flex items-center justify-between gap-4 rounded-2xl border border-[#00a88e]/25 bg-white p-6 shadow-sm"><div><p class="text-[15px] font-bold text-[#0f172a]">Houve retoque nesta visita?</p><p class="text-[12px] text-[#64748b]">Marque Sim para registrar fotos de retoque e mapa corretivo desta visita</p></div><button type="button" role="switch" aria-checked="false" class="relative h-8 w-14 shrink-0 rounded-full transition-colors bg-[#cbd5e1]"><span class="absolute top-1 h-6 w-6 rounded-full bg-white shadow transition-transform left-1"></span></button></div><div class="mt-auto flex justify-end border-t border-app-border pt-6"><button type="button" class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-xl bg-app-accent px-6 py-3 text-[14px] font-semibold text-white shadow-sm hover:bg-[#00967f] disabled:cursor-not-allowed disabled:opacity-60">Concluir Retorno</button></div></div></div></div>"`;
